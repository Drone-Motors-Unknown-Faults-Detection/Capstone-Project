# 複製成 docker/.env 後修改（.env 已在 .gitignore）。未設定的變數使用 compose 檔內預設值。

# --- vLLM（vllm.compose.yaml）---
VLLM_IMAGE_TAG=26.09-py3
# 預設 FP8（約 31 GB）；BF16 原版約 61 GB：Qwen/Qwen3-30B-A3B-Instruct-2507
QWEN3_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507-FP8
VLLM_MAX_MODEL_LEN=32768
# GB10 為 128 GB 統一記憶體，與系統、展示伺服器共用；0.5 ≈ 64 GB 給權重 + KV cache
VLLM_GPU_MEMORY_UTILIZATION=0.5
VLLM_PORT=8000
HF_CACHE_DIR=~/.cache/huggingface
HF_TOKEN=

# --- 展示（app.compose.yaml）---
APP_UID=1000
APP_GID=1000
WEB_PORT=8600
MOTOR=T1
RPM=8000rpm
RATE=4
LLM_URL=http://vllm:8000/v1
LLM_MODEL=qwen3
