flowchart TD
  H["健康資料（8screws）<br/>105 維特徵窗"] --> FIT["擬合健康基準<br/>RobustScaler＋Ledoit–Wolf 馬氏距離"]
  FIT --> CAL["健康校準資料定門檻<br/>距離 95% 分位數"]
  CAL --> X["新特徵窗逐筆到達"]
  X --> D{"正規化分數 > 1？"}
  D -- 否 --> K["判為已知類別<br/>繼續監測"]
  D -- 是 --> U["判為未知"]
  U --> G{"分數 > 2？"}
  G -- 否 --> B["只發警報<br/>不進隔離區"]
  G -- 是 --> Q["進入隔離區累積"]
  Q --> C{"每 10 筆試一次 HDBSCAN<br/>有 ≥ 25 筆的群？"}
  C -- 否 --> Q
  C -- 是 --> P["候選群"]
  P --> A1["實驗二批次：adopt()<br/>只用群內樣本自學新類<br/>命名 discovered-N"]
  P --> A2["首頁展示／導覽：confirm()<br/>人員確認後揭示配置"]
  A2 -- 已知類邊界樣本 --> R["退回，清除該群<br/>量尺不變"]
  A2 -- 新配置 --> A3["讀該配置完整資料池"]
  A1 --> RF["全部已知類重新擬合<br/>量尺擴張"]
  A3 --> RF
  RF --> X
  K --> X
  B --> X
  R --> X
  U -.-> T["趨勢分支：未知旗標 EWMA<br/>判別漸進或突發"]
